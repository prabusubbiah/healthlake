{
	"name": "pipeline2",
	"properties": {
		"activities": [
			{
				"name": "metadatalookup for ingestion",
				"description": "list of tables details from metadata tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select table_id from ctrl_schema.table_config where is_active='True' and source_system='@{pipeline().parameters.souce_system}';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ingest all tables",
				"description": "get the table list from @lookup activity and process one by one using @foreach activity",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "metadatalookup for ingestion",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('metadatalookup for ingestion').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "check values",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "test",
								"value": {
									"value": "@string(item().table_id)",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"souce_system": {
				"type": "string",
				"defaultValue": "neon_postgres"
			}
		},
		"variables": {
			"test": {
				"type": "String"
			}
		},
		"annotations": []
	}
}